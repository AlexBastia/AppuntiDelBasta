(* Here the comparison happens inside the body of lambda x, so x is a
   variable in the context. It is not the variable bound by the inner
   lambda x, even though they have the same name. *)

axiom A : Type 0
axiom g : A -> A -> A
axiom U : (A -> A) -> Type 0
axiom t : Pi (x : A) -> U (g x)
def test : Pi (x : A) -> U (lambda x. g x x) := lambda x. t x
