(* Requirement R1: every type is equal to itself.

   Dependent pairs. The type of the second component depends on the value
   of the first. *)

axiom A : Type 0
axiom a : A
axiom P : A -> Type 0
axiom pa : P a

def dp : Sigma (x : A) * P x := (a, pa)
def x : A := fst dp

(* The type of the second projection mentions the first. *)
def y : P (fst dp) := snd dp

(* A non-dependent pair type is written A * B. *)
def np : A * unit := (a, tt)

def swap : Pi (A : Type 0) -> Pi (B : Type 0) -> A * B -> B * A :=
  lambda A B p. (snd p, fst p)

check swap A unit np
