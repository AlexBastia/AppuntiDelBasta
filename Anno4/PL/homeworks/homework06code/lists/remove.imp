@ list(l) * (n >= 0) @

if l != 0 then {
if n = 0 then {
  tmp := l;
  l := *(l + 1);
  free(2, tmp)
} else {

prev := l;
p := *(l+1);
i := 1;
while (i != n and p != 0) do @ lseg(l, prev) * prev |-> _ * (prev + 1) |-> p * list(p) @
{
  prev := p;
  p := *(p + 1);
  i := i + 1
}
if (p != 0) then {
    next := *(p + 1);
    *(prev + 1) := next;
    free(2, p);
}

}
}

@ list(l) @
