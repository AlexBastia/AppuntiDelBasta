@ list(l) @

if (l = 0) then {
  dup := 0
} else {
  v := *l;
  p := *(l+1);
  dup := new(v, 0);
  q := dup;
  while (p != 0) do @ lseg(dup, q) * q |-> _ * (q + 1) |-> 0 * lseg(l, p) * list(p) @
  {
    v := *p;
    tmp := new(v, 0);
    *(q + 1) := tmp;
    q := *(q + 1);
    p := *(p + 1);
  }
}

@ list(l) * list(dup) @
